   "source": [
    "# Panel A: Prediction vs. Ground Truth with Physical Context\n",
    "\n",
    "This notebook demonstrates the creation of Panel A: A time-series plot showing the model's predicted surface roughness (Ra) overlaid on the measured ground truth, with a color-coded background indicating the dominant physical regime at each moment.\n",
    "\n",
    "The plot uses a color gradient where:\n",
    "- Blue represents ductile-dominated mode (BDI > 1)\n",
    "- Red represents brittle-fracture mode (BDI < 1)\n",
    "\n",
    "Caption Insight: \"The model demonstrates high fidelity in predicting Ra (MAE = X.X). Notably, prediction accuracy remains robust during transitions between ductile (blue) and brittle (red) machining regimes, showcasing the model's ability to capture non-stationary dynamics.\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup and Imports"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import torch\n",
    "from matplotlib.patches import Patch\n",
    "from matplotlib.lines import Line2D\n",
    "import matplotlib as mpl\n",
    "\n",
    "# Add parent directory to path to import project modules\n",
    "sys.path.append(os.path.dirname(os.path.abspath('.')))\n",
    "\n",
    "# Set up plotting style\n",
    "plt.rcParams['figure.constrained_layout.use'] = True\n",
    "mpl.rcParams['figure.dpi'] = 300\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "\n",
    "print(\"Imports completed successfully\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Ground Truth Data with Physical Context\n",
    "\n",
    "First, we load the ground truth surface roughness values along with their corresponding BDI (Brittleness Ductility Index) values to understand the physical machining regimes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_physics_data():\n",
    "    \"\"\"\n",
    "    Load physics data including surface roughness and BDI values.\n",
    "    \"\"\"\n",
    "    from GrindingData import GrindingData\n",
    "    from MyDataset import project_dir\n",
    "    \n",
    "    # Create GrindingData instance\n",
    "    grinding_data = GrindingData(project_dir)\n",
    "    \n",
    "    # Load only physics data (much more efficient)\n",
    "    print(\"Loading physics data...\")\n",
    "    grinding_data._load_all_physics_data()\n",
    "    \n",
    "    # Extract the data we need\n",
    "    true_values = grinding_data.sr * 1e3  # Convert to μm\n",
    "    bdi_values = grinding_data.bid\n",
    "    st_values = grinding_data.st\n",
    "    \n",
    "    # Convert to numpy arrays and ensure proper shape\n",
    "    true_values = np.array(true_values).flatten()\n",
    "    bdi_values = np.array(bdi_values).flatten()\n",
    "    st_values = np.array(st_values).flatten()\n",
    "    \n",
    "    print(f\"Loaded physics data for {len(true_values)} samples\")\n",
    "    print(f\"BDI range: {np.min(bdi_values):.3f} to {np.max(bdi_values):.3f}\")\n",
    "    print(f\"Surface roughness range: {np.min(true_values):.3f} to {np.max(true_values):.3f} μm\")\n",
    "    \n",
    "    return true_values, bdi_values, st_values\n",
    "\n",
    "# Load the data\n",
    "true_values, bdi_values, st_values = load_physics_data()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Plot Ground Truth with Physical Context\n",
    "\n",
    "First, let's visualize just the ground truth surface roughness with the BDI regime coloring to understand the physical context."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def plot_ground_truth_with_physics(true_values, bdi_values, sample_indices=None):\n",
    "    \"\"\"\n",
    "    Create time-series plot showing ground truth surface roughness\n",
    "    with background colored by BDI regime.\n",
    "    \"\"\"\n",
    "    if sample_indices is None:\n",
    "        sample_indices = np.arange(len(true_values))\n",
    "    \n",
    "    fig, ax = plt.subplots(figsize=(12, 6))\n",
    "    \n",
    "    # Plot ground truth\n",
    "    ax.plot(sample_indices, true_values, 'o-', label='Ground Truth', \n",
    "            color='black', alpha=0.8, markersize=4, linewidth=1.5)\n",
    "    \n",
    "    # Create background colors based on BDI regime\n",
    "    y_min, y_max = ax.get_ylim()\n",
    "    \n",
    "    # Find transitions between BDI regimes\n",
    "    bdi_regime = bdi_values > 1.0  # True for ductile, False for brittle\n",
    "    \n",
    "    # Group consecutive samples with same regime\n",
    "    regime_changes = np.where(np.diff(bdi_regime.astype(int)) != 0)[0] + 1\n",
    "    regime_starts = np.concatenate(([0], regime_changes))\n",
    "    regime_ends = np.concatenate((regime_changes, [len(bdi_regime)]))\n",
    "    \n",
    "    # Color background based on BDI regime\n",
    "    for start, end in zip(regime_starts, regime_ends):\n",
    "        regime = bdi_regime[start]\n",
    "        color = 'lightblue' if regime else 'lightcoral'\n",
    "        alpha = 0.3 if regime else 0.2\n",
    "        \n",
    "        # Extend slightly beyond data range for visual clarity\n",
    "        x_start = sample_indices[max(0, start-0.5)]\n",
    "        x_end = sample_indices[min(len(sample_indices)-1, end-0.5)]\n",
    "        \n",
    "        ax.axvspan(x_start, x_end, ymin=0, ymax=1, alpha=alpha, color=color)\n",
    "    \n",
    "    # Customize plot\n",
    "    ax.set_xlabel('Sample Index')\n",
    "    ax.set_ylabel('Surface Roughness Ra ($\\\\mu$m)')\n",
    "    ax.set_title('Ground Truth Surface Roughness with Physical Context')\n",
    "    \n",
    "    # Create legend with regime information\n",
    "    legend_elements = [\n",
    "        Line2D([0], [0], color='black', marker='o', linestyle='-', label='Ground Truth'),\n",
    "        Patch(facecolor='lightblue', alpha=0.3, label='BDI > 1 (Ductile)'),\n",
    "        Patch(facecolor='lightcoral', alpha=0.2, label='BDI < 1 (Brittle)')\n",
    "    ]\n",
    "    ax.legend(handles=legend_elements, loc='upper right')\n",
    "    \n",
    "    ax.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Add statistics\n",
    "    mean_roughness = np.mean(true_values)\n",
    "    std_roughness = np.std(true_values)\n",
    "    ductile_ratio = np.mean(bdi_regime) * 100\n",
    "    \n",
    "    stats_text = f\"Mean Ra: {mean_roughness:.2f} μm\\nStd Ra: {std_roughness:.2f} μm\\nDuctile regime: {ductile_ratio:.1f}%\"\n",
    "    ax.text(0.02, 0.98, stats_text, \n",
    "            transform=ax.transAxes, fontsize=10, \n",
    "            bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"white\", alpha=0.8),\n",
    "            verticalalignment='top')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    return fig, ax\n",
    "\n",
    "# Plot ground truth with physical context (first 100 samples for clarity)\n",
    "n_samples = min(100, len(true_values))\n",
    "fig_gt, ax_gt = plot_ground_truth_with_physics(\n",
    "    true_values[:n_samples], \n",
    "    bdi_values[:n_samples],\n",
    "    sample_indices=np.arange(n_samples)\n",
    ")\n",
    "plt.show()"
   ]
  },
